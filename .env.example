# ==========================================================================
# SentinelFlow configuration
# --------------------------------------------------------------------------
# Copy to `.env` and edit. Every value below has a working default, so
# SentinelFlow runs with no .env file at all.
#
# NEVER put real credentials, API keys or production secrets in this file.
# `.env` is gitignored; `.env.example` is committed and must stay generic.
# ==========================================================================

# --- Application ---------------------------------------------------------
SENTINELFLOW_ENVIRONMENT=development       # development | test | production
SENTINELFLOW_DEBUG=false

# --- Storage -------------------------------------------------------------
# SQLite by default. Relative paths resolve against the project root.
SENTINELFLOW_DATABASE_URL=sqlite:///data/sentinelflow.db

# --- HTTP server ---------------------------------------------------------
SENTINELFLOW_API_HOST=127.0.0.1             # bind to loopback only by default
SENTINELFLOW_API_PORT=8000
# Extra host names the server answers to, besides localhost and loopback
# addresses. Any other Host header is refused, which stops DNS rebinding.
# Needed only behind a reverse proxy; wildcards are refused.
# SENTINELFLOW_ALLOWED_HOSTS=sentinel.lab.internal
# Interactive API docs at /docs (loads Swagger UI from a CDN when on).
SENTINELFLOW_API_DOCS_ENABLED=false

# --- Analyst -------------------------------------------------------------
# Recorded on every decision, note and audit entry. Defaults to your account
# name. Attribution for a single local analyst, not authentication.
# SENTINELFLOW_ANALYST_NAME=analyst

# --- Logging -------------------------------------------------------------
SENTINELFLOW_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
SENTINELFLOW_LOG_FORMAT=text                # text | json
# SENTINELFLOW_LOG_FILE=logs/sentinelflow.log

# --- Ingestion limits (defence against oversized / hostile input) --------
SENTINELFLOW_MAX_UPLOAD_BYTES=10485760      # 10 MiB
SENTINELFLOW_MAX_EVENTS_PER_IMPORT=10000
SENTINELFLOW_MAX_FIELD_LENGTH=8192

# --- Correlation ---------------------------------------------------------
SENTINELFLOW_CORRELATION_WINDOW_MINUTES=30

# --- Optional local AI ---------------------------------------------------
# SentinelFlow is fully functional with AI disabled. The AI never sets the
# official severity; it only produces a clearly-labelled advisory analysis.
SENTINELFLOW_AI_ENABLED=false
SENTINELFLOW_AI_PROVIDER=none               # none | ollama
SENTINELFLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434
SENTINELFLOW_OLLAMA_MODEL=llama3.1:8b
SENTINELFLOW_AI_TIMEOUT_SECONDS=60
# Evidence contains usernames, hostnames and internal addresses. A provider URL
# that is not on this machine is refused unless this is set deliberately.
SENTINELFLOW_AI_ALLOW_REMOTE_PROVIDER=false
